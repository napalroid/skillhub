.service-list-table-header{display:none;}
@media(min-width:1024px){.service-list-table-header{display:grid;grid-template-columns:80px 1.5fr 1fr auto;gap:2rem;padding:0.875rem 1.5rem;background:#fafbfc;border-bottom:1px solid var(--line);}.service-list-table-header span{font-size:0.6875rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);}}

.service-item{display:grid;gap:1.25rem;padding:1.5rem 1.25rem;border-bottom:1px solid var(--line);transition:background 140ms ease;animation:service-enter 200ms ease both;}
.service-item:last-child{border-bottom:none;}
.service-item:hover{background:#fafbfc;}
@media(min-width:1024px){.service-item{grid-template-columns:80px 1.5fr 1fr auto;align-items:center;gap:2rem;padding:1.5rem;}}
@keyframes service-enter{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}}

/* === Service Item Parts === */
.service-visual{display:flex;align-items:center;gap:0.75rem;}
@media(min-width:1024px){.service-visual{display:block;}}
.service-index{font-size:0.75rem;font-weight:600;color:var(--muted);font-variant-numeric:tabular-nums;}
.service-thumb{margin-top:0.75rem;width:4.5rem;height:4.5rem;overflow:hidden;border-radius:0.5rem;background:#f1f3f5;}
@media(min-width:1024px){.service-thumb{margin-top:0.75rem;}}
.service-thumb img{width:100%;height:100%;object-fit:cover;transition:transform 160ms ease;}
.service-item:hover .service-thumb img{transform:scale(1.03);}
.service-thumb-empty{display:flex;align-items:center;justify-content:center;width:100%;height:100%;color:var(--muted);}
.service-thumb-empty svg{width:1.25rem;height:1.25rem;stroke-width:1.5;}

.service-details{min-width:0;}
.service-taxonomy{display:flex;flex-wrap:wrap;align-items:center;gap:0.375rem;font-size:0.75rem;color:var(--muted);}
.service-taxonomy span:not([aria-hidden]){display:inline;}
.service-taxonomy [aria-hidden]{color:#c1c7d0;}
.service-name{margin-top:0.5rem;font-size:1rem;font-weight:600;color:var(--black);line-height:1.3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.service-meta-row{margin-top:0.625rem;display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;}

/* === Status Badge === */
.status-badge{display:inline-flex;align-items:center;padding:0.25rem 0.625rem;font-size:0.75rem;font-weight:600;border:1px solid;border-radius:0.375rem;}
.status-approved{color:#065f46;background:#d1fae5;border-color:#a7f3d0;}
.status-pending{color:#92400e;background:#fef3c7;border-color:#fde68a;}
.status-rejected{color:#991b1b;background:#fee2e2;border-color:#fecaca;}
.status-draft{color:#475569;background:#f1f5f9;border-color:#e2e8f0;}

/* === Booking Section === */
.service-booking{padding-top:1rem;border-top:1px solid var(--line);}
