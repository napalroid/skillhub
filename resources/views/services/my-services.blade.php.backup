@push('scripts')
<script>
document.addEventListener('DOMContentLoaded',function(){
    const cat=document.getElementById('filterCategory');
    const sub=document.getElementById('filterSubcategory');
    if(!cat||!sub)return;
    const opts=sub.querySelectorAll('option');
    function sync(){
        const val=cat.value;
        const cur=sub.value;
        let clr=true;
        opts.forEach(o=>{
            if(!o.value)return;
            const match=!val||o.dataset.category===val;
            o.hidden=!match;
            if(match&&o.value===cur)clr=false;
        });
        if(clr&&val)sub.value='';
    }
    cat.addEventListener('change',sync);
    sync();
});
</script>
@endpush
@endsection
