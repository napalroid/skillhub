/* === Empty State === */
.workspace-empty{margin-top:3rem;padding:4rem 1.5rem;text-align:center;background:var(--surface);border:1px dashed var(--line);border-radius:0.75rem;}
.workspace-empty .empty-eyebrow{font-size:0.8125rem;font-weight:600;color:var(--blue);}
