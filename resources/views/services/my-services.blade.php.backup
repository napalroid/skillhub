<style>
/* === Core Variables === */
.seller-workspace{--black:#0a0c0f;--ink:#1a1d23;--gray:#4a5568;--muted:#6b7280;--line:#e2e5ea;--surface:#ffffff;--canvas:#fafbfc;--blue:#2563eb;--blue-dark:#1e40af;--emerald:#059669;--amber:#d97706;--rose:#dc2626;font-family:'Inter',ui-sans-serif,system-ui,sans-serif;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;color:var(--ink);background:var(--canvas);}

/* === Focus Management === */
.seller-workspace :focus-visible{outline:2px solid var(--blue);outline-offset:2px;}

/* === Typography Scale === */
.workspace-label{font-size:0.6875rem;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--muted);}
.workspace-meta{font-size:0.8125rem;color:var(--gray);line-height:1.5;}
.workspace-title{font-size:1rem;font-weight:600;color:var(--ink);line-height:1.4;}
.workspace-price{font-size:0.9375rem;font-weight:600;color:var(--black);font-variant-numeric:tabular-nums;}

/* === Layout Primitives === */
.workspace-container{max-width:1360px;margin:0 auto;padding:3.5rem 1.25rem 5rem;}
.workspace-header{padding-bottom:2.5rem;border-bottom:1px solid var(--line);}
.workspace-nav{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.875rem;font-weight:500;color:var(--muted);text-decoration:none;transition:color 140ms ease;}
.workspace-nav:hover{color:var(--ink);}
.workspace-nav svg{width:0.875rem;height:0.875rem;transition:transform 140ms ease;}
.workspace-nav:hover svg{transform:translateX(-2px);}

.workspace-heading-group{margin-top:2rem;}
.workspace-eyebrow{font-size:0.8125rem;font-weight:600;color:var(--blue);letter-spacing:0.02em;}
.workspace-h1{margin-top:0.75rem;font-size:clamp(2.25rem,4vw,3rem);font-weight:700;line-height:1.05;letter-spacing:-0.02em;color:var(--black);}
.workspace-description{margin-top:1rem;max-width:38rem;font-size:0.9375rem;line-height:1.6;color:var(--gray);}

/* === Actions === */
.action-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;min-height:2.75rem;padding:0 1.25rem;font-size:0.875rem;font-weight:600;color:white;background:var(--black);border:1px solid var(--black);border-radius:0.5rem;text-decoration:none;transition:background 140ms ease,transform 140ms ease;}
.action-primary:hover{background:#000;}
.action-primary:active{transform:scale(0.98);}
.action-primary svg{width:1rem;height:1rem;stroke-width:2;}

.action-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:2.75rem;padding:0 1rem;font-size:0.875rem;font-weight:600;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:0.5rem;text-decoration:none;transition:border-color 140ms ease,background 140ms ease;}
.action-secondary:hover{border-color:#c1c7d0;background:#f7f8fa;}
.action-secondary:active{transform:scale(0.98);}

.action-link{display:inline-flex;align-items:center;font-size:0.875rem;font-weight:600;color:var(--blue);text-decoration:none;transition:color 140ms ease;}
.action-link:hover{color:var(--blue-dark);}

/* === Filter Section === */
.workspace-filter-area{margin-top:2.5rem;padding-bottom:2.5rem;border-bottom:1px solid var(--line);}
.filter-grid{display:grid;gap:1rem;}
@media(min-width:768px){.filter-grid{grid-template-columns:1fr 1fr auto;align-items:end;}}
.filter-label{display:block;}
.filter-label-text{display:block;margin-bottom:0.5rem;font-size:0.8125rem;font-weight:600;color:var(--ink);}
.filter-select{display:block;width:100%;min-height:2.75rem;padding:0 0.75rem;font-size:0.875rem;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:0.5rem;transition:border-color 140ms ease;}
