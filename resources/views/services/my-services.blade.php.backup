.booking-action{margin-top:0.75rem;}

/* === Actions Column === */
.service-actions{display:flex;flex-wrap:wrap;gap:0.5rem;padding-top:1rem;border-top:1px solid var(--line);}
@media(min-width:1024px){.service-actions{justify-content:flex-end;padding-top:0;border-top:none;}}
